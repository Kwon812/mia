{
  "manifest_version": 3,
  "name": "Project NA",
  "version": "0.0.1",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "idle",
    "topSites",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "net-content.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mia-web-nine.vercel.app/connect*",
        "http://localhost:3000/connect*"
      ],
      "js": [
        "connect-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Project NA",
    "default_popup": "popup.html"
  }
}